            <bpmn2:callActivity id="CallActivity_32380909" name="Handle_Employee_Exception">
                <bpmn2:extensionElements>
                    <ifl:property>
                        <key>bodyType</key>
                        <value>expression</value>
                    </ifl:property>
                    <ifl:property>
                        <key>propertyTable</key>
                        <value/>
                    </ifl:property>
                    <ifl:property>
                        <key>headerTable</key>
                        <value>&lt;row&gt;&lt;cell id='Action'&gt;Create&lt;/cell&gt;&lt;cell id='Type'&gt;constant&lt;/cell&gt;&lt;cell id='Value'&gt;SAP CPI - Employee Processing Failed&lt;/cell&gt;&lt;cell id='Default'&gt;&lt;/cell&gt;&lt;cell id='Name'&gt;Subject&lt;/cell&gt;&lt;cell id='Datatype'&gt;&lt;/cell&gt;&lt;/row&gt;</value>
                    </ifl:property>
                    <ifl:property>
                        <key>wrapContent</key>
                        <value>Hello Team,

An error occurred while processing employee data.

Status: FAILED

Error Details: ${exception.message}

Please check SAP CPI Message Processing Log
for further details.

Regards,
SAP CPI Integration Team</value>
                    </ifl:property>
                    <ifl:property>
                        <key>componentVersion</key>
                        <value>1.6</value>
                    </ifl:property>
