<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

    <xs:element name="PayrollEmployee">
        <xs:complexType>
            <xs:sequence>
                <xs:element name="EmployeeNumber" type="xs:string"/>
                <xs:element name="FullName" type="xs:string"/>
                <xs:element name="SalaryDetails">
                    <xs:complexType>
                        <xs:sequence>
                            <xs:element name="Basic" type="xs:decimal"/>
                            <xs:element name="HousingAllowance" type="xs:decimal"/>
                            <xs:element name="OtherAllowance" type="xs:decimal"/>
                            <xs:element name="GrossSalary" type="xs:decimal"/>
                        </xs:sequence>
                    </xs:complexType>
                </xs:element>
            </xs:sequence>
        </xs:complexType>
    </xs:element>

</xs:schema>
